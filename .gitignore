# macOS / 系统文件
.DS_Store

# Python 缓存与虚拟环境
__pycache__/
*.py[cod]
*.so
.python-version
.venv/
venv/
env/

# 测试与工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 本地环境变量
.env
.env.*

# 历史行情与分析派生数据（默认不入库）

# Raw and clean market data (regenerable)
data/raw/
data/binance_kline/
data/opend_kline/
data/mcp_kline/
data/clean/

# Pipeline outputs
# runs 中间文件可再生；summary/details/scored/metrics 可按需入库
outputs/runs/**/input.parquet
outputs/runs/**/eval_input.csv
outputs/runs/**/runs.jsonl

# Data catalog（项目索引，建议入库）

# 回测运行产物（默认不入库）
eval/results/

# 通用日志
*.log
